# Core Environment Configuration
APP_NAME=whatsapp-notification-router
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# Security & Webhook Verification
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
META_APP_SECRET=your-meta-app-secret-hash

# Database Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=router_user
POSTGRES_PASSWORD=router_password
POSTGRES_DB=notification_router
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Redis Cache & Broker Settings
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_DEFAULT_SECONDS=3600
PREFERENCE_CACHE_TTL_SECONDS=86400

# LLM & AI Engine Configuration
GEMINI_API_KEY=your-gemini-api-key
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
LLM_TIMEOUT_SECONDS=5.0
LLM_MAX_RETRIES=2

# Vector Retrieval (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=whatsapp_history_embeddings
